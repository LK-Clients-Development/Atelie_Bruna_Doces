{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "astro"
    },
    "apresentacao": {
      "root": "apresentacao",
      "framework": "vite",
      "rewrites": [
        { "source": "/apresentacao/(.*)", "destination": "/$1" },
        { "source": "/apresentacao", "destination": "/" }
      ]
    }
  },
  "rewrites": [
    { "source": "/apresentacao", "destination": { "service": "apresentacao" } },
    { "source": "/apresentacao/(.*)", "destination": { "service": "apresentacao" } },
    { "source": "/(.*)", "destination": { "service": "app" } }
  ]
}
