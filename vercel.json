{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "astro"
    },
    "apresentacao": {
      "root": "apresentacao",
      "framework": "vite",
      "routes": [
        {
          "src": "/apresentacao/(.*)",
          "transforms": [
            { "type": "request.path", "op": "set", "args": "/$1" }
          ]
        },
        {
          "src": "/apresentacao",
          "transforms": [
            { "type": "request.path", "op": "set", "args": "/" }
          ]
        }
      ]
    }
  },
  "rewrites": [
    { "source": "/apresentacao", "destination": { "service": "apresentacao" } },
    { "source": "/apresentacao/(.*)", "destination": { "service": "apresentacao" } },
    { "source": "/(.*)", "destination": { "service": "app" } }
  ]
}
