{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "astro"
    },
    "apresentacao": {
      "root": "apresentacao",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/apresentacao",
      "destination": { "service": "apresentacao", "path": "/" }
    },
    {
      "source": "/apresentacao/:path*",
      "destination": { "service": "apresentacao", "path": "/:path*" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "app" }
    }
  ]
}
