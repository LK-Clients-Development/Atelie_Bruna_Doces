---
/**

 * /produtos: portfólio / galeria de criações do Ateliê (Concept 09 V2: álbum editorial). NÃO é cardápio de compra: o visitante
 * descobre, abre uma criação (modal com galeria) e só então segue para o WhatsApp ou o cardápio
 * Yooga. Não há carrinho nem checkout.
 *
 * Duas camadas de dados, nenhuma escrita aqui:
 *   EDITORIAL  src/data/portfolio.ts (categorias editoriais, galeria de imagens, compra)
 *   ARTE       src/data/portfolio-layout.ts (variante visual de cada capítulo; só decisão de layout)
 *   COMERCIAL  src/data/products.ts (snapshot do Yooga; preço e opções ficam lá e NÃO aparecem na galeria)
 *
 * - Os cards carregam só a imagem principal; as demais fotos são pedidas quando o modal abre.
 * - Busca, filtro por categoria e modal rodam no cliente (src/scripts/products.ts) sobre o HTML
 *   já renderizado: sem JS a galeria inteira aparece e cada card leva ao WhatsApp.
 * - Menu de Bolos NÃO foi auditado (CAKES_MENU.status = 'pending'): o bloco "Bolos por encomenda"
 *   não lista nenhum bolo, preço ou sabor.
 * - Provisório: imagem do bloco de bolos (recorte da Master). Textos institucionais: PRODUCTS_PAGE
 *   em src/data/site.ts (precisam de aprovação da Bruna).
 */
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';
import SectionEyebrow from '../components/SectionEyebrow.astro';
import CtaButton from '../components/CtaButton.astro';
import PortfolioChapter from '../components/PortfolioChapter.astro';
import Icon from '../components/Icon.astro';
import Wave from '../components/Wave.astro';
import Seal from '../components/Seal.astro';
import { BRAND, LINKS, PRODUCTS_PAGE, isPending, linkAttrs } from '../data/site';
import { CAKES_MENU } from '../data/products';
import { IMAGES } from '../data/images';
import { EDITORIAL_CATEGORIES, PORTFOLIO, getDisplayableImages } from '../data/portfolio';
import { EDITORIAL_MOMENTS } from '../data/portfolio-layout';
import heroCake from '../assets/portfolio/bolo-de-cenoura/03-angle.webp';
import heroSlice from '../assets/portfolio/fatia-chocolatuda/04-context.webp';
import { normalizeSearchText } from '../lib/search';
import '../styles/products.css';
import '../styles/product-modal.css';

const page = PRODUCTS_PAGE;

// grupos por categoria editorial (só as que têm itens publicados)
const groups = EDITORIAL_CATEGORIES.map((category) => ({
  ...category,
  products: PORTFOLIO.filter((product) => product.category === category.slug),
})).filter((group) => group.products.length > 0);

const count = (n: number, one: string, many: string) => `${n} ${n === 1 ? one : many}`;

// busca: nome, descrição e categoria (normalizados, sem acento)
const searchText = new Map(
  PORTFOLIO.map((p) => [
    p.slug,
    normalizeSearchText([p.name, p.shortDescription ?? '', EDITORIAL_CATEGORIES.find((c) => c.slug === p.category)!.name].join(' ')),
  ]),
);

// dados do modal (embutidos na página; as imagens só são pedidas ao abrir)
const modalData = PORTFOLIO.map((p) => ({
  slug: p.slug,
  name: p.name,
  category: EDITORIAL_CATEGORIES.find((c) => c.slug === p.category)!.name,
  description: p.editorialDescription ?? p.shortDescription,
  images: getDisplayableImages(p).map((i) => ({ src: i.src, width: i.width, height: i.height, alt: i.alt })),
  whatsapp: p.purchase.whatsappHref,
  yooga: p.purchase.yoogaHref,
}));

// Hero: composição editorial com imagens aprovadas já no projeto (bolo de cenoura e fatia = geradas e aprovadas,
// 03-angle e 04-context; a pequena é a foto do Yooga). Decorativas: o nome dos produtos está nos tiles.
const heroSmall = PORTFOLIO.find((p) => p.slug === 'coxinha-belga')?.heroImage;

// Menu de Bolos: enquanto não houver arquivo público auditado, o CTA vai para o WhatsApp (documentado)
const menuReady = CAKES_MENU.status === 'audited' && !isPending(LINKS.menuBolos);
const cakesHref = menuReady ? LINKS.menuBolos : LINKS.whatsapp;
const cakesLabel = menuReady ? page.cakes.ctaMenu : page.cakes.ctaFallback;
---

<BaseLayout title={`${page.title} | ${BRAND.name}`} path="/produtos" header={{ current: 'produtos', base: '/', solid: true }}>
  <main id="conteudo" tabindex="-1" class="products-page">
    {/* 01 Hero editorial: texto + busca à esquerda, composição fotográfica à direita */}
    <section class="phero" aria-labelledby="produtos-titulo">
      <div class="phero__art" aria-hidden="true">
        <div class="phero__main">
          <Image src={heroCake} alt="" widths={[640, 960, 1122]} sizes="(max-width: 899px) 100vw, 56vw" loading="eager" fetchpriority="high" />
        </div>
        <figure class="phero__paper phero__paper--a">
          <Image src={heroSlice} alt="" widths={[360, 560]} sizes="(max-width: 899px) 40vw, 24vw" loading="eager" />
          <figcaption class="phero__script" data-copy-status={EDITORIAL_MOMENTS.heroNote.status}>{EDITORIAL_MOMENTS.heroNote.text}</figcaption>
        </figure>
        {heroSmall?.src && (
          <figure class="phero__paper phero__paper--b">
            <img src={heroSmall.src} width={heroSmall.width ?? undefined} height={heroSmall.height ?? undefined} alt="" loading="lazy" decoding="async" />
          </figure>
        )}
      </div>
      <div class="container phero__inner">
        <SectionEyebrow>{page.eyebrow}</SectionEyebrow>
        <h1 class="h1 phero__title" id="produtos-titulo">
          <span class="line"><span class="line__in">{page.heroTitle[0]}</span></span>{' '}
          <span class="line"><span class="line__in">{page.heroTitle[1]} <span class="h3 phero__em">{page.heroTitle[2]}</span></span></span>
        </h1>
        <p class="t1 phero__lead">{page.heroLead}</p>
        <div class="psearch" data-search-wrap hidden>
          <form class="psearch__form" role="search" aria-label="Buscar nas criações" data-search-form novalidate>
            <Icon name="search" size={20} />
            <label class="sr-only" for="produtos-busca">Buscar uma criação</label>
            <input
              id="produtos-busca"
              class="psearch__input"
              type="search"
              name="q"
              placeholder={page.searchPlaceholder}
              autocomplete="off"
              enterkeyhint="search"
              data-search-input
            />
            <button class="psearch__go" type="submit" aria-label="Buscar"><Icon name="arrow" size={20} /></button>
          </form>
        </div>
      </div>
    </section>

    {/* 03 O álbum: intro + capítulos */}
    <section class="pcatalog" aria-label="Galeria de criações">
    {/* 02 Categorias: navegação tipográfica (filtro com JS; âncoras sem JS). Dentro do álbum: o sticky termina com ele */}
    <nav class="prail" aria-label="Categorias do portfólio">
      <ul class="prail__list" role="list" data-rail>
        <li>
          <a class="prail__item" href="#catalogo" data-rail-link="all" aria-current="true">Todos</a>
        </li>
        {groups.map((group) => (
          <li>
            <a class="prail__item" href={`#${group.slug}`} data-rail-link={group.slug}>{group.name}</a>
          </li>
        ))}
      </ul>
    </nav>

      <div class="container pintro" id="catalogo">
        <div class="pintro__title">
          <SectionEyebrow>{page.catalogEyebrow}</SectionEyebrow>
          <h2 class="h2">
            <span class="line">{page.catalogTitle[0]}</span>{' '}
            <span class="line h3">{page.catalogTitle[1]}</span>
          </h2>
        </div>
        <p class="t1 pintro__lead">{page.catalogLead}</p>
        <p class="pintro__stats">
          <strong>{PORTFOLIO.length}</strong>{' '}
          <span>{PORTFOLIO.length === 1 ? 'criação' : 'criações'}</span>{' '}
          <small>em {groups.length} {groups.length === 1 ? 'categoria' : 'categorias'}</small>
        </p>
        <div class="pintro__band" aria-hidden="true">
          <Image src={IMAGES.manifestoChocolate} alt="" widths={[313]} sizes="30vw" />
          <p class="pintro__script" data-copy-status={EDITORIAL_MOMENTS.albumNote.status}>{EDITORIAL_MOMENTS.albumNote.text}</p>
        </div>
      </div>

      <div class="container pcatalog__body">
        <p class="presults" data-results role="status" aria-live="polite" hidden></p>
        <div class="pempty" data-empty hidden>
          <p class="pempty__title">Nenhuma criação encontrada.</p>
          <button class="pempty__btn" type="button" data-reset>Ver todas as criações</button>
        </div>

        {groups.map((group, i) => (
          <PortfolioChapter slug={group.slug} name={group.name} products={group.products} index={i + 1} {searchText} />
        ))}
      </div>
    </section>

    {/* 04 Bolos por encomenda: CAKES_MENU.status = 'pending' → nenhum bolo, preço ou sabor listado */}
    <section class="pcakes" aria-labelledby="bolos-titulo">
      <div class="container">
        <div class="pcakes__band" data-provisional="imagem-bolos-provisoria">
          <div class="pcakes__photo" aria-hidden="true">
            <Image src={IMAGES.criacoesBolo} alt="" widths={[480, 751]} sizes="(max-width: 899px) 100vw, 30vw" />
          </div>
          <div class="pcakes__text">
            <SectionEyebrow>{page.cakes.eyebrow}</SectionEyebrow>
            <h2 class="h2 pcakes__h2" id="bolos-titulo">
              <span class="line">{page.cakes.title[0]}</span>{' '}
              <span class="line h3">{page.cakes.title[1]}</span>
            </h2>
            <p class="t1 pcakes__lead">{page.cakes.text}</p>
            <a class="pbtn" href={cakesHref} {...linkAttrs(cakesHref)} data-cakes-cta={menuReady ? 'menu' : 'whatsapp-fallback'}>
              <span>{cakesLabel}</span><Icon name="arrow" size={20} />
            </a>
          </div>
          <div class="pcakes__side">
            <div class="pcakes__seal"><Seal /></div>
          </div>
        </div>
      </div>
    </section>

    {/* 05 CTA final */}
    <section class="section2 pcta" aria-labelledby="cta-titulo">
      <Wave shape="dark-band" band line />
      <div class="container section__inner pcta__inner">
        <div class="pcta__text">
          <SectionEyebrow>{page.cta.eyebrow}</SectionEyebrow>
          <h2 class="h2 pcta__h2" id="cta-titulo">
            <span class="line">{page.cta.title[0]}</span>{' '}
            <span class="line h3">{page.cta.title[1]}</span>
          </h2>
          <p class="t1 pcta__lead">{page.cta.text}</p>
        </div>
        <div class="cta-actions pcta__actions">
          <CtaButton href={LINKS.cardapio}>{page.cta.order}</CtaButton>
          <CtaButton href={LINKS.whatsapp} variant="btn3" icon="whatsapp">{page.cta.whatsapp}</CtaButton>
        </div>
      </div>
    </section>
  </main>

  <Footer base="/" />

  {/* Modal de produto: preenchido por src/scripts/products.ts; as fotos só carregam ao abrir */}
  <div class="pmodal" data-modal hidden>
    <div class="pmodal__backdrop" data-modal-close></div>
    <div class="pmodal__dialog" role="dialog" aria-modal="true" aria-labelledby="pmodal-title" tabindex="-1" data-dialog>
      <button class="pmodal__close" type="button" data-modal-close aria-label="Fechar"><Icon name="close" size={22} /></button>
      <div class="pmodal__scroll">
        <div class="pmodal__gallery" role="group" aria-roledescription="galeria" aria-label="Fotos da criação">
          <div class="pmodal__stage" data-stage>
            <button class="pmodal__nav pmodal__nav--prev" type="button" data-prev aria-label="Foto anterior" hidden><Icon name="arrow" size={22} /></button>
            <button class="pmodal__nav pmodal__nav--next" type="button" data-next aria-label="Próxima foto" hidden><Icon name="arrow" size={22} /></button>
            <p class="pmodal__count" data-count aria-live="polite" hidden></p>
          </div>
          <ul class="pmodal__thumbs" role="list" data-thumbs hidden></ul>
        </div>
        <div class="pmodal__info">
          <p class="pmodal__cat" data-m-cat></p>
          <h2 class="pmodal__title" id="pmodal-title" data-m-title></h2>
          <p class="pmodal__desc" data-m-desc></p>
        </div>
      </div>
      <div class="pmodal__actions">
        <a class="pbtn" href={LINKS.whatsapp} target="_blank" rel="noopener" data-m-wa><Icon name="whatsapp" size={22} /><span>Quero este produto</span><span class="sr-only"> (abre o WhatsApp em nova aba)</span></a>
        <a class="pbtn pbtn--ghost" href={LINKS.cardapio} target="_blank" rel="noopener" data-m-yooga><span>Ver cardápio no Yooga</span><span class="sr-only"> (abre em nova aba)</span><Icon name="arrow" size={22} /></a>
      </div>
    </div>
  </div>
  <script type="application/json" id="portfolio-data" set:html={JSON.stringify(modalData)} />

  <script>
    import '../scripts/products';
    import '../scripts/product-modal';
  </script>
</BaseLayout>
