---
/**
 * Barra inferior comercial (só mobile/tablet < 900px): Início · Produtos · Loja · Pedir.
 * Respeita a safe-area do iOS, some com o menu ou a ficha de produto abertos e reserva espaço no fim da página
 * (padding do body) para não cobrir rodapé nem botões. Não há botão flutuante de WhatsApp no site.
 */
import Icon from './Icon.astro';
import { GO } from '../data/commerce';

interface Props { current?: 'inicio' | 'produtos'; base?: string }
const { current = 'inicio', base = '' } = Astro.props;
const home = base ? '/' : '#inicio';
const store = base ? '/#loja' : '#loja';
---

<nav class="dock" aria-label="Atalhos">
  <a class="dock__item" href={home} aria-current={current === 'inicio' ? 'page' : undefined}>
    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 11 12 4l8 7v8a1 1 0 0 1-1 1h-4v-6H9v6H5a1 1 0 0 1-1-1z" /></svg>
    <span>Início</span>
  </a>
  <a class="dock__item" href="/produtos" aria-current={current === 'produtos' ? 'page' : undefined}>
    <Icon name="grid" size={22} /><span>Produtos</span>
  </a>
  <a class="dock__item" href={store}>
    <Icon name="pin" size={22} /><span>Loja</span>
  </a>
  <a class="dock__item dock__item--cta" href={GO.delivery} target="_blank" rel="noopener noreferrer" data-track="delivery_click" data-track-place="dock">
    <Icon name="arrow" size={22} /><span>Pedir</span>
  </a>
</nav>

<style>
  .dock { display: none; }
  @media (max-width: 899px) {
    .dock {
      position: fixed;
      inset: auto 0 0 0;
      z-index: 90; /* abaixo do header (100), do menu (200) e do modal */
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      padding: 6px 8px calc(6px + env(safe-area-inset-bottom));
      background: rgb(251 243 235 / 0.96);
      backdrop-filter: blur(10px);
      border-top: 1px solid var(--color-line);
      box-shadow: 0 -12px 28px -22px rgb(43 24 16 / 0.55);
    }
    .dock__item {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 3px;
      min-height: 52px;
      color: var(--color-cacao-800);
      font-size: 0.6875rem;
      font-weight: 500;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      text-decoration: none;
    }
    .dock__item[aria-current='page'] { color: var(--color-caramel-600); }
    .dock__item--cta {
      background: var(--color-cacao-800);
      color: var(--color-text-light);
      border-radius: var(--radius-pill);
      margin-inline: 4px;
    }
    :global(body) { padding-bottom: calc(64px + env(safe-area-inset-bottom)); }
    :global(html.menu-open) .dock,
    :global(html.is-modal-open) .dock { display: none; }
  }
</style>
