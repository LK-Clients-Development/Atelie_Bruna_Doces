---
/**
 * Card do portfólio (/produtos): foto, nome, categoria/descrição curta e "Ver criação".
 * Sem preço, oferta ou "a partir de": o preço continua só no snapshot comercial.
 *
 * - Carrega apenas a imagem PRINCIPAL (as demais fotos só são pedidas quando o modal abre).
 * - Sem foto exibível: superfície da marca com o nome, sem fingir ser fotografia.
 * - O link cobre o card inteiro. Com JS ele abre o modal (src/scripts/products.ts); sem JS cai no
 *   WhatsApp (mensagem com o nome do produto) para o card nunca ficar morto.
 */
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { linkAttrs } from '../data/site';
import { IMAGES } from '../data/images';
import { EDITORIAL_CATEGORIES, type PortfolioProduct } from '../data/portfolio';

interface Props {
  product: PortfolioProduct;
  /** Primeira linha do grid: a foto não é lazy (evita atraso no LCP). */
  eager?: boolean;
}

const { product, eager = false } = Astro.props;
const hero = product.heroImage;
const category = EDITORIAL_CATEGORIES.find((c) => c.slug === product.category)!.name;
const href = product.purchase.whatsappHref ?? '#';
---

<article class="pcard" data-slug={product.slug}>
  <div class:list={['pcard__media', !hero && 'pcard__media--empty']}>
    {
      hero && hero.src ? (
        <img
          src={hero.src}
          width={hero.width ?? undefined}
          height={hero.height ?? undefined}
          alt=""
          loading={eager ? 'eager' : 'lazy'}
          decoding="async"
        />
      ) : (
        <div class="pcard__fallback" aria-hidden="true">
          <Image class="pcard__flower" src={IMAGES.florLinha} alt="" width={44} />
          <span class="pcard__fallback-name">{product.name}</span>
        </div>
      )
    }
  </div>
  <div class="pcard__body">
    <p class="pcard__cat">{category}</p>
    <h3 class="pcard__name">{product.name}</h3>
    {product.shortDescription && <p class="pcard__desc">{product.shortDescription}</p>}
    <a class="pcard__cta" href={href} {...linkAttrs(href)} data-open={product.slug}>
      <span>Ver criação<span class="sr-only">: {product.name}</span></span>
      <Icon name="arrow" size={18} />
    </a>
  </div>
</article>
