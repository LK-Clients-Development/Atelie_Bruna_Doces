---
/**
 * Novidades regionais (Extrema e Camanducaia) — concept editorial aprovado.
 *
 * Lê TUDO de src/data/regional.ts (textos, status e links). O botão do grupo só é renderizado quando a
 * cidade tem convite válido E divulgação autorizada (groupCta); sem isso o card mostra um estado
 * informativo não clicável. As ilustrações dos cards são composições artísticas (sem identificação
 * geográfica real). As paisagens dos cards são ilustrações editoriais aprovadas (src/assets/regional). A foto do bolo é um asset do portfólio já aprovado (bolo-de-cenoura/04-context).
 */
import { Image } from 'astro:assets';
import Wave from './Wave.astro';
import Icon from './Icon.astro';
import { REGIONAL_NEWS, DELIVERY_STATUS_LABEL, groupCta } from '../data/regional';
import { linkAttrs } from '../data/site';
import { BRAND_FLOWER as F } from '../data/brand-flower';
import cakePhoto from '../assets/portfolio/bolo-de-cenoura/04-context.webp';
import artExtrema from '../assets/regional/regional-extrema.webp';
import artCamanducaia from '../assets/regional/regional-camanducaia.webp';

const { kicker, title, subtitle, cities } = REGIONAL_NEWS;
const lastLine = title.length - 1;

// Ilustrações editoriais aprovadas pelo Owner (composições artísticas, NÃO fotos documentais dos locais).
// pos/posM = object-position por cidade (desktop / mobile): cada composição tem seu próprio enquadramento.
const ART: Record<string, { src: ImageMetadata; alt: string; pos: string; posM: string }> = {
  extrema: {
    src: artExtrema,
    alt: 'Ilustração editorial de montanhas e vale ao entardecer, com flores em primeiro plano',
    pos: '62% 55%',
    posM: '60% 60%',
  },
  camanducaia: {
    src: artCamanducaia,
    alt: 'Ilustração editorial de montanhas ao pôr do sol, com igreja, araucárias e hortênsias',
    pos: '50% 50%',
    posM: '68% 58%',
  },
};
---

<section class="regional" id="novidades" aria-labelledby="novidades-titulo" data-regional>
  <Wave shape="soft" />
  <div class="regional__bg" aria-hidden="true">
    <svg class="regional__swoosh regional__swoosh--l" viewBox="0 0 300 600" preserveAspectRatio="none" focusable="false">
      <path d="M0 330 C90 300 160 380 130 460 C110 520 40 540 0 520" />
    </svg>
    <svg class="regional__swoosh regional__swoosh--r" viewBox="0 0 400 300" preserveAspectRatio="none" focusable="false">
      <path d="M400 40 C300 60 240 140 260 220 C270 262 330 290 400 280" />
    </svg>
  </div>

  <div class="container regional__inner">
    <div class="regional__stage">
      <header class="regional__head">
        <p class="regional__kicker" data-reveal style="--i:0">
          <span aria-hidden="true"></span>{kicker}<span aria-hidden="true"></span>
        </p>
        <h2 class="regional__title" id="novidades-titulo" data-reveal style="--i:1">
          {title.map((line, i) => <span class:list={['regional__line', { 'is-italic': i === lastLine }]}>{line}</span>)}
        </h2>
        <p class="t1 regional__lead" data-reveal style="--i:2">{subtitle}</p>
      </header>

      <div class="regional__photo" data-reveal style="--i:1">
        <Image
          src={cakePhoto}
          alt="Bolo de cenoura com cobertura de chocolate, uma das criações do Ateliê Doces Bruna"
          widths={[480, 720, 960]}
          sizes="(max-width: 899px) 92vw, 46vw"
          loading="lazy"
        />
      </div>

      <svg class="regional__flower" viewBox={F.viewBox} aria-hidden="true" focusable="false">
        <path d={F.petals} fill="none" stroke="currentColor" stroke-width="5" fill-rule="evenodd" />
      </svg>
    </div>

    <ul class="regional__grid" role="list">
      {
        cities.map((city, i) => {
          const cta = groupCta(city);
          const art = ART[city.id];
          return (
            <li class="city" data-city={city.id} data-status={city.status} data-has-cta={cta ? 'true' : 'false'} data-reveal style={`--i:${i + 3}`}>
              <Image class="city__land" src={art.src} alt={art.alt} widths={[640, 960, 1280]} sizes="(max-width: 899px) 92vw, 46vw" loading="lazy" style={`--pos:${art.pos};--pos-m:${art.posM}`} />

              <p class="city__place t3">
                <Icon name="pin" size={18} />
                <span>{city.name} · {city.state}</span>
              </p>
              <h3 class="city__title">{city.name}</h3>
              <p class="city__status">
                <span class="city__dot" aria-hidden="true" />
                <span>{DELIVERY_STATUS_LABEL[city.status]}</span>
              </p>
              {city.statusNote && <p class="city__note">{city.statusNote}</p>}
              <p class="city__headline">{city.headline}</p>
              <p class="t1 city__detail">{city.detail}</p>

              {cta ? (
                <>
                  <a class="rbtn" href={cta.href} {...linkAttrs(cta.href)}>
                    <Icon name="whatsapp" size={22} />
                    <span>{cta.label}</span>
                    <Icon name="arrow" size={22} />
                  </a>
                  {cta.note && <p class="city__shared">{cta.note}</p>}
                </>
              ) : (
                <p class="city__soon">O link do grupo será divulgado em breve.</p>
              )}
            </li>
          );
        })
      }
    </ul>

    <p class="regional__illus">Imagens ilustrativas.</p>

    <div class="regional__divider" aria-hidden="true">
      <span></span>
      <svg viewBox={F.viewBox} width="30" height="33" focusable="false">
        <path d={F.petals} fill="none" stroke="currentColor" stroke-width="7" fill-rule="evenodd" />
      </svg>
      <span></span>
    </div>
  </div>
</section>

<script>
  // Entrada suave ao rolar. Só esconde algo quando html.motion-ready (sem JS ou com movimento reduzido tudo aparece).
  const root = document.querySelector<HTMLElement>('[data-regional]');
  if (root) {
    const targets = root.querySelectorAll<HTMLElement>('[data-reveal]');
    if (!('IntersectionObserver' in window)) {
      targets.forEach((el) => el.classList.add('is-in'));
    } else {
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('is-in');
              io.unobserve(e.target);
            }
          });
        },
        { threshold: 0.15 },
      );
      targets.forEach((el) => io.observe(el));
    }
  }
</script>

<style>
  .regional {
    --section-bg: #fcefe4;
    --rg-caramel: #b8602f;
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background:
      radial-gradient(60% 50% at 88% 12%, rgb(255 233 214 / 0.95), transparent 70%),
      radial-gradient(50% 45% at 8% 85%, rgb(254 214 190 / 0.75), transparent 70%),
      linear-gradient(180deg, #fcefe4, #fbe6d6);
    padding-block: calc(var(--wave-h) + clamp(24px, 3vw, 48px)) clamp(48px, 6vw, 96px);
  }

  .regional__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .regional__swoosh {
    position: absolute;
    fill: none;
    stroke: var(--rg-caramel);
    stroke-width: 1;
    opacity: 0.45;
    vector-effect: non-scaling-stroke;
  }

  .regional__swoosh path {
    vector-effect: non-scaling-stroke;
  }

  .regional__swoosh--l {
    left: 0;
    top: 22%;
    width: clamp(70px, 9vw, 150px);
    height: 36%;
  }

  .regional__swoosh--r {
    right: 0;
    bottom: 8%;
    width: clamp(90px, 14vw, 240px);
    height: 28%;
  }

  .regional__inner {
    position: relative;
    z-index: var(--z-content);
  }

  /* ---------- palco: texto + foto ---------- */
  .regional__stage {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 0.7fr);
    align-items: start;
    gap: var(--layout-col-gap);
  }

  .regional__head {
    position: relative;
    z-index: 2;
    padding-top: clamp(8px, 2vw, 32px);
  }

  .regional__kicker {
    display: flex;
    align-items: center;
    gap: clamp(12px, 1.6vw, 24px);
    margin-bottom: clamp(14px, 1.6vw, 24px);
    font-size: var(--text-eyebrow);
    font-weight: 600;
    letter-spacing: var(--tracking-micro);
    text-transform: uppercase;
    color: var(--color-caramel-600);
  }

  .regional__kicker span {
    width: clamp(28px, 3.4vw, 52px);
    height: 1px;
    background: currentColor;
    opacity: 0.75;
  }

  .regional__title {
    font-family: var(--font-display);
    font-weight: 400;
    line-height: 0.98;
    letter-spacing: var(--tracking-display);
    color: var(--color-cacao-950);
    font-size: clamp(2.5rem, 4.7vw, 4.9rem);
  }

  .regional__line {
    display: block;
  }

  @media (min-width: 900px) {
    .regional__line {
      white-space: nowrap;
    }
  }

  .regional__line.is-italic {
    font-style: italic;
    color: var(--rg-caramel);
  }

  .regional__lead {
    margin-top: clamp(14px, 1.8vw, 26px);
    max-width: 31rem;
  }

  .regional__photo {
    position: relative;
    z-index: 1;
    margin-right: calc(var(--bleed, 0px) * -1);
    aspect-ratio: 1 / 0.92;
    -webkit-mask-image: radial-gradient(ellipse 54% 52% at 56% 46%, #000 48%, transparent 100%);
    mask-image: radial-gradient(ellipse 54% 52% at 56% 46%, #000 48%, transparent 100%);
  }

  .regional__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 58%;
  }

  .regional__flower {
    position: absolute;
    left: clamp(-64px, -4vw, -24px);
    top: 60%;
    width: clamp(48px, 5.4vw, 88px);
    height: auto;
    color: var(--rg-caramel);
    opacity: 0.8;
    transform: rotate(-12deg);
    z-index: 0;
  }

  /* ---------- cards ---------- */
  .regional__grid {
    position: relative;
    z-index: 3;
    margin: clamp(-72px, -4.4vw, -24px) 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(16px, 2.6vw, 40px);
  }

  .city {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: clamp(22px, 2.6vw, 40px);
    border: 1px solid rgb(255 255 255 / 0.85);
    border-radius: 34px;
    background: linear-gradient(160deg, rgb(255 251 247 / 0.78), rgb(255 238 225 / 0.6));
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    box-shadow:
      0 0 0 1px rgb(205 140 95 / 0.28),
      0 28px 48px -32px rgb(120 60 25 / 0.55);
  }

  /* ilustração do card: ancorada no alto/direita; a máscara funde com o creme à esquerda e embaixo,
     deixando a área de texto e o botão limpos. Enquadramento por cidade (--pos). */
  .city :global(.city__land) {
    position: absolute;
    inset: 0 0 auto auto;
    z-index: -2;
    width: 82%;
    height: 82%;
    object-fit: cover;
    object-position: var(--pos, 60% 50%);
    -webkit-mask-image: linear-gradient(to right, transparent 0%, rgb(0 0 0 / 0.35) 28%, #000 62%), linear-gradient(to bottom, #000 62%, transparent 100%);
    -webkit-mask-composite: source-in;
    mask-image: linear-gradient(to right, transparent 0%, rgb(0 0 0 / 0.35) 28%, #000 62%), linear-gradient(to bottom, #000 62%, transparent 100%);
    mask-composite: intersect;
  }

  /* véu creme leve só sobre a faixa de texto */
  .city::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(90deg, rgb(255 248 241 / 0.7) 0%, rgb(255 246 238 / 0.5) 45%, rgb(255 244 235 / 0) 80%);
    pointer-events: none;
  }

  .city__place {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--color-caramel-600);
  }

  .city__title {
    margin-top: clamp(8px, 1vw, 14px);
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2.25rem, 3.8vw, 4rem);
    line-height: 1;
    letter-spacing: var(--tracking-display);
    color: var(--color-cacao-950);
  }

  .city__status {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: clamp(12px, 1.4vw, 18px);
    padding: 6px 16px;
    border-radius: var(--radius-pill);
    background: rgb(255 226 205 / 0.85);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-cacao-800);
  }

  .city__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--rg-caramel);
  }

  .city__note {
    margin-top: 8px;
    font-size: 0.8125rem;
    color: var(--color-caramel-600);
  }

  .city__headline {
    margin-top: clamp(16px, 2vw, 28px);
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1.25rem, 2vw, 1.9rem);
    line-height: 1.2;
    color: var(--rg-caramel);
  }

  .city__detail {
    margin-top: 10px;
    max-width: 30rem;
  }

  /* botão cacau (CTA do grupo) */
  .rbtn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    width: 100%;
    margin-top: clamp(18px, 2.2vw, 30px);
    padding: clamp(14px, 1.4vw, 18px) clamp(20px, 2vw, 30px);
    border-radius: var(--radius-pill);
    background: linear-gradient(180deg, #5a2c1a, #3a1c10);
    color: var(--color-text-light);
    font-size: var(--text-btn);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    box-shadow: 0 14px 24px -14px rgb(40 15 5 / 0.8), inset 0 1px 0 rgb(255 255 255 / 0.14);
    transition: transform 0.25s ease, box-shadow 0.25s ease, background-color 0.25s ease;
  }

  .rbtn span {
    text-align: center;
  }

  .rbtn:hover {
    transform: translateY(-2px);
    background: linear-gradient(180deg, #6a3320, #46231a);
    box-shadow: 0 20px 30px -16px rgb(40 15 5 / 0.85), inset 0 1px 0 rgb(255 255 255 / 0.18);
  }

  .rbtn:active {
    transform: translateY(0);
  }

  .rbtn:focus-visible {
    outline: 3px solid var(--color-caramel-400);
    outline-offset: 3px;
  }

  .city__shared,
  .city__soon {
    margin-top: 12px;
    font-size: 0.8125rem;
    line-height: 1.4;
    color: var(--color-caramel-600);
  }

  .regional__illus {
    margin-top: clamp(14px, 1.6vw, 22px);
    text-align: center;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    color: var(--color-caramel-600);
    opacity: 0.85;
  }

  .regional__divider {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
    margin-top: clamp(28px, 3.4vw, 52px);
    color: var(--rg-caramel);
  }

  .regional__divider span {
    flex: 0 1 clamp(80px, 14vw, 220px);
    height: 1px;
    background: currentColor;
    opacity: 0.55;
  }

  /* desktop: texto numa coluna mais estreita, para a paisagem ficar à direita sem competir com a leitura */
  @media (min-width: 900px) {
    .city__headline,
    .city__detail {
      max-width: min(64%, 28rem);
    }
  }

  /* ---------- movimento (só com html.motion-ready) ---------- */
  :global(html.motion-ready) .regional [data-reveal]:not(.is-in) {
    opacity: 0;
    transform: translateY(18px);
  }

  :global(html.motion-ready) .regional [data-reveal] {
    transition:
      opacity 0.8s ease calc(var(--i, 0) * 90ms),
      transform 0.8s ease calc(var(--i, 0) * 90ms);
  }

  /* ---------- tablet ---------- */
  @media (max-width: 1100px) {
    .regional__stage {
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.7fr);
    }
  }

  @media (max-width: 899px) {
    .regional__stage {
      grid-template-columns: 1fr;
    }

    .regional__photo {
      margin: 0 auto;
      width: min(100%, 560px);
      aspect-ratio: 1 / 0.8;
    }

    .regional__grid {
      margin-top: 0;
      grid-template-columns: 1fr;
    }

    .regional__flower {
      left: auto;
      right: 4%;
      top: 4%;
    }
  }

  /* ---------- mobile ---------- */
  @media (max-width: 640px) {
    .regional__title {
      font-size: clamp(2.25rem, 10vw, 3rem);
    }

    .city {
      border-radius: 26px;
      padding-top: 150px;
    }

    .city :global(.city__land) {
      inset: 0 0 auto 0;
      width: 100%;
      height: 150px;
      object-position: var(--pos-m, 60% 55%);
      -webkit-mask-image: linear-gradient(to bottom, #000 62%, transparent 100%);
      mask-image: linear-gradient(to bottom, #000 62%, transparent 100%);
    }

    .city::before {
      display: none;
    }

    .city__place {
      position: absolute;
      top: 18px;
      left: 22px;
      color: var(--color-cacao-800);
    }

    .rbtn {
      letter-spacing: 0.1em;
      font-size: 0.8125rem;
    }
  }
</style>
